# Omtech Corporation - Production .htaccess configuration
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force HTTPS and canonical non-www domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.omtechcorporation\.com [NC]
RewriteRule ^(.*)$ https://omtechcorporation.com/$1 [L,R=301]

# 2. Permanent 301 Redirects for Old WordPress / Legacy URLs
RewriteRule ^fire-protection-and-suppression/?$ /fire-gas-systems.html [R=301,L]
RewriteRule ^fire-protection-suppression-systems/?$ /fire-gas-systems.html [R=301,L]
RewriteRule ^fire-protection/?$ /fire-gas-systems.html [R=301,L]
RewriteRule ^plumbing-and-bulk-drinking-water-solution/?$ /water-treatment.html [R=301,L]
RewriteRule ^water-solution/?$ /water-treatment.html [R=301,L]
RewriteRule ^about-us/?$ /about.html [R=301,L]
RewriteRule ^about/?$ /about.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]
RewriteRule ^contact/?$ /contact.html [R=301,L]
RewriteRule ^services/?$ /services.html [R=301,L]
RewriteRule ^our-services/?$ /services.html [R=301,L]
RewriteRule ^corporate-training/?$ /corporate-training.html [R=301,L]
RewriteRule ^training/?$ /corporate-training.html [R=301,L]
RewriteRule ^industrial-training/?$ /corporate-training.html [R=301,L]
RewriteRule ^safety-training/?$ /safety-training.html [R=301,L]
RewriteRule ^future-leaders/?$ /future-leaders.html [R=301,L]
RewriteRule ^hse-process-safety/?$ /hse-process-safety.html [R=301,L]
RewriteRule ^management-system-audits/?$ /hse-process-safety.html [R=301,L]
RewriteRule ^cyber-security/?$ /cyber-security.html [R=301,L]
RewriteRule ^cybersecurity/?$ /cyber-security.html [R=301,L]
RewriteRule ^virtual-design-studio/?$ /virtual-design-studio.html [R=301,L]
RewriteRule ^industries/?$ /industries.html [R=301,L]
RewriteRule ^gallery/?$ /gallery.html [R=301,L]
RewriteRule ^media/?$ /gallery.html [R=301,L]
RewriteRule ^privacy-policy/?$ /privacy.html [R=301,L]
RewriteRule ^terms-and-conditions/?$ /terms.html [R=301,L]

# 3. Clean URLs (Rewrite /page to /page.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# 4. Protect sensitive data files from direct HTTP access
<FilesMatch "^(leads_backup\.json|\.htaccess|\.env|test_db_script\.php)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# 5. Enable browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
